Algoritmo ejer_1
	
	Definir peso, m Como Real
	m = 0
	Escribir "Báscula de manzanas"
	
	
	Mientras m < 1000 Hacer
		Escribir "Ingrese el peso de su manzana"
		Leer peso
		m = m + peso
		Escribir"Usted lleva ", m, " gramos"
	Fin Mientras
	
	Escribir "Haz alcanzado un kilo de manzanas"
	
FinAlgoritmo
