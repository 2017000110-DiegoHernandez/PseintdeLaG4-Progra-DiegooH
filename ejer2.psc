Algoritmo ejer2
	
	Definir total, m Como Real
	
	total =0
	Mientras total < 350 Hacer
		Escribir "Tienes ", total, " monedas"
		Escribir "Nivel 5 bloqueado"
		Escribir "Ingrese sus monedas adicionales"
		Leer m
		total = total + m
	Fin Mientras
	
	Escribir "Nivel 5 desbloqueado"
	
	
FinAlgoritmo
